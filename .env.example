# Docker Compose için bu dosyayı proje kökünde .env olarak kopyalayın.
# Değerleri yerel ortamınızda doldurun; gerçek değerleri Git'e eklemeyin.
DB_PASSWORD=
# Kriptografik olarak rastgele, en az 32 bayt uzunluğunda bağımsız anahtar.
JWT_SECRET=
# Mevcut Hibernate şemasının ilk Flyway geçişinde true yapın; ardından false'a döndürün.
FLYWAY_BASELINE_ON_MIGRATE=false
